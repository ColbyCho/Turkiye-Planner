# Copy to .env.local and fill in from your Supabase project:
#   Project Settings → API → Project URL / Project API keys → anon public
#
# Without these the site still runs — every shared feature quietly falls back
# to this-device-only storage. Fill them in and the same features become shared.
# Both are inlined into the built JavaScript and are meant to be public; what
# the anon key can touch is decided by the policies in supabase/schema.sql.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
